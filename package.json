{
  "name": "piano_playroom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env -e .env.local -- next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e .env.local -- prisma studio"
  },
  "prisma": {
    "seed": "dotenv -e .env.local -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.15",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.2",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
